# 秒下 VideoGrab · AI 视频总结配置模板
# 用法：复制本文件为 .env 后填写。.env 已加入 .gitignore，不会随仓库上传。
# 系统环境变量优先级高于本文件，部署时可直接用环境变量临时覆盖。
# 只填 AI_BASE_URL / AI_API_KEY / AI_MODEL 即可用；全部留空则页面上「AI 总结」给出配置指引。

# 主端点：任意 OpenAI Chat Completions 兼容服务（DeepSeek / 通义 / OpenAI / 自建网关…）
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat

# 只想用本地模型（Ollama / LM Studio）时，请把上面三行的值留空，只填下面两行，
# 否则会先拿空密钥打一次云端端点、失败后才自动切本地（结果正确，但多一次无效请求）。
# 本地兜底：主端点不可用或调用失败时自动切换（Ollama / LM Studio 等）
AI_FALLBACK_BASE_URL=http://127.0.0.1:11434/v1
AI_FALLBACK_MODEL=qwen2.5:7b

# 调用与长视频分段控制
AI_TIMEOUT=120
AI_MAX_CHARS=12000
AI_MAX_SEGMENTS=12

# 字幕正文缓存（秒 / 最多缓存条数）
SUBTITLE_TTL=1800
SUBTITLE_CACHE_MAX=50

# AI 笔记结果缓存（秒）：同一视频 + 同一 Cookie + 同一风格只生成一次，
# 关面板 / 去下载 / 刷新回来直接复用，不再重复调用模型。只存服务端内存，
# 服务重启后失效；想重算点面板里的「重新生成」。默认 3600 秒（1 小时）。
AI_NOTE_TTL=3600
